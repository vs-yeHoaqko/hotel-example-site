{
  "schemaVersion": 1,
  "reportPath": "evaluation/reports/quality-gate.md",
  "ciSummaryReportPath": "evaluation/reports/ci-gate-summary.md",
  "sources": {
    "runHealthConfigPath": "evaluation/config/run-health.config.json",
    "testMeaningfulnessConfigPath": "evaluation/config/test-meaningfulness.config.json",
    "migrationCandidatesConfigPath": "evaluation/config/migration-candidates.config.json",
    "thinningDecisionsConfigPath": "evaluation/config/thinning-decisions.config.json"
  },
  "requiredEvidence": [
    {
      "id": "latest-summary",
      "source": "summary",
      "condition": "latest-run-readable",
      "modes": ["gate", "full", "collect-all"],
      "enforcement": "fail",
      "rationale": "The quality gate cannot be trusted unless the latest evaluation run produced a readable summary."
    },
    {
      "id": "environment-layer",
      "source": "summary",
      "condition": "layer-passed",
      "layer": "environment",
      "modes": ["gate", "full", "collect-all"],
      "enforcement": "fail",
      "rationale": "Environment preflight must pass before product or test failures can be interpreted safely."
    },
    {
      "id": "smoke-e2e-layer",
      "source": "summary",
      "condition": "layer-passed",
      "layer": "smoke-e2e",
      "modes": ["gate", "full", "collect-all"],
      "enforcement": "fail",
      "rationale": "The required smoke E2E journey preserves minimum reservation-completion browser confidence."
    }
  ],
  "thresholds": [
    {
      "id": "weak-signal-tests",
      "source": "test-meaningfulness",
      "metric": "weakSignalTests",
      "operator": "max",
      "warnAt": 0,
      "enforcement": "warn",
      "rationale": "Tests without assertion-like checks should be reviewed before their count is treated as meaningful coverage."
    },
    {
      "id": "total-tests",
      "source": "test-meaningfulness",
      "metric": "totalTests",
      "operator": "min",
      "warnAt": 136,
      "enforcement": "warn",
      "rationale": "A sudden drop in discovered tests may indicate accidental coverage loss or test discovery drift."
    },
    {
      "id": "assertion-like-checks",
      "source": "test-meaningfulness",
      "metric": "assertionCount",
      "operator": "min",
      "warnAt": 572,
      "enforcement": "warn",
      "rationale": "A sudden drop in assertion-like checks may indicate weaker evidence."
    },
    {
      "id": "baseline-regressions",
      "source": "run-health",
      "metric": "baselineRegressions",
      "operator": "max",
      "warnAt": 0,
      "enforcement": "warn",
      "rationale": "Layer regressions should be reviewed before tightening fail-enforced policy."
    },
    {
      "id": "baseline-missing",
      "source": "run-health",
      "metric": "baselineMissing",
      "operator": "max",
      "warnAt": 0,
      "enforcement": "warn",
      "rationale": "Missing layer observations reduce confidence in the baseline comparison."
    },
    {
      "id": "environment-evidence",
      "source": "diagnostics",
      "metric": "environmentEvidence",
      "operator": "max",
      "warnAt": 0,
      "enforcement": "warn",
      "rationale": "Environment evidence should be resolved before test or product changes."
    },
    {
      "id": "flaky-evidence",
      "source": "diagnostics",
      "metric": "flakyEvidence",
      "operator": "max",
      "warnAt": 0,
      "enforcement": "warn",
      "rationale": "Flaky evidence should be made visible while the threshold remains warning-first."
    }
  ]
}
