{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "mode",
    "target",
    "repository",
    "startedAt",
    "finishedAt",
    "status",
    "counts",
    "recommendedNextAction",
    "diagnostics",
    "layers",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "runId": { "type": "string" },
    "mode": { "type": "string", "enum": ["gate", "full", "collect-all"] },
    "target": { "type": "string", "enum": ["local", "deployed"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit", "dirty", "changedFiles"],
      "properties": {
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "dirty": { "type": "boolean" },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status"],
            "properties": {
              "path": { "type": "string" },
              "status": {
                "type": "string",
                "enum": [
                  "modified",
                  "added",
                  "deleted",
                  "renamed",
                  "untracked",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "startedAt": { "type": "string" },
    "finishedAt": { "type": "string" },
    "status": { "type": "string", "enum": ["passed", "failed", "error"] },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "skipped", "timeout"],
      "properties": {
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "skipped": { "type": "integer" },
        "timeout": { "type": "integer" }
      }
    },
    "recommendedNextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "none",
            "inspect_product",
            "inspect_test",
            "fix_environment",
            "investigate_unknown"
          ]
        },
        "message": { "type": "string" }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "layer",
          "ownerLayer",
          "classification",
          "title",
          "source",
          "message",
          "excerpt",
          "expected",
          "actual",
          "reproduction",
          "artifacts",
          "guidance"
        ],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["test_case", "layer_command", "runner_error"]
          },
          "layer": { "type": "string" },
          "ownerLayer": {
            "type": "string",
            "enum": ["unit", "integration", "e2e", "gate", "unknown"]
          },
          "classification": {
            "type": "string",
            "enum": ["product", "test", "environment", "timeout", "unknown"]
          },
          "title": { "type": "string" },
          "source": {
            "type": "object",
            "nullable": true,
            "additionalProperties": false,
            "required": ["path", "line"],
            "properties": {
              "path": { "type": "string" },
              "line": { "type": "integer", "nullable": true }
            }
          },
          "message": { "type": "string" },
          "excerpt": { "type": "string", "nullable": true },
          "expected": { "type": "string", "nullable": true },
          "actual": { "type": "string", "nullable": true },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "display"],
            "properties": {
              "level": { "type": "string", "enum": ["test", "layer"] },
              "display": { "type": "string" }
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "kind", "label"],
              "properties": {
                "path": { "type": "string" },
                "kind": {
                  "type": "string",
                  "enum": [
                    "stdout",
                    "stderr",
                    "playwright_json",
                    "trace",
                    "screenshot",
                    "video",
                    "attachment",
                    "summary",
                    "other"
                  ]
                },
                "label": { "type": "string" }
              }
            }
          },
          "guidance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "confidence", "rationale", "likelyTargets"],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "inspect_product",
                  "inspect_test",
                  "fix_environment",
                  "investigate_unknown"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "rationale": { "type": "string" },
              "likelyTargets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "path", "label", "rationale"],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "product_file",
                        "evaluation_file",
                        "behavior_area",
                        "environment"
                      ]
                    },
                    "path": { "type": "string", "nullable": true },
                    "label": { "type": "string" },
                    "rationale": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required",
          "status",
          "command",
          "exitCode",
          "durationMs",
          "timedOut",
          "skippedReason",
          "counts",
          "classification",
          "artifacts"
        ],
        "properties": {
          "name": { "type": "string" },
          "required": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped"]
          },
          "command": {
            "type": "object",
            "additionalProperties": false,
            "required": ["configuredArgv", "executedArgv", "env", "display"],
            "properties": {
              "configuredArgv": {
                "type": "array",
                "items": { "type": "string" }
              },
              "executedArgv": {
                "type": "array",
                "items": { "type": "string" }
              },
              "env": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "required": [],
                "properties": {}
              },
              "display": { "type": "string" }
            }
          },
          "exitCode": { "type": "integer", "nullable": true },
          "durationMs": { "type": "integer" },
          "timedOut": { "type": "boolean" },
          "skippedReason": { "type": "string", "nullable": true },
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "failed", "skipped", "timeout"],
            "properties": {
              "passed": { "type": "integer" },
              "failed": { "type": "integer" },
              "skipped": { "type": "integer" },
              "timeout": { "type": "integer" }
            }
          },
          "classification": {
            "type": "string",
            "nullable": true,
            "enum": ["product", "test", "environment", "timeout", "unknown"]
          },
          "artifacts": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
